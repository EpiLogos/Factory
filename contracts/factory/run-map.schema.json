{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory.run-map.schema/v1",
  "title": "Factory Project, Run, canonical Run Map and Run-owned cognitive field contract",
  "$defs": {
    "projectRef": {"type": "string", "pattern": "^project:[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "runRef": {"type": "string", "pattern": "^run:[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "ref": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "revision": {"type": "integer", "minimum": 1},
    "mapAddress": {"type": "string", "pattern": "^run:[0-7][0-9A-HJKMNP-TV-Z]{25}/map$"},
    "nodeState": {"enum": ["planned", "ready", "active", "blocked", "waiting", "satisfied", "returned", "superseded", "abandoned"]},
    "nodeKind": {"enum": ["destination", "position", "work", "decision", "candidate", "gate", "authority", "nested_run"]},
    "edgeKind": {"enum": ["requires", "branches_to", "returns_to", "nests", "converges_to", "realises", "supersedes"]},
    "topologyNode": {
      "type": "object",
      "required": ["id", "kind", "label", "state", "semanticRef"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "kind": {"$ref": "#/$defs/nodeKind"},
        "label": {"type": "string"},
        "state": {"anyOf": [{"$ref": "#/$defs/nodeState"}, {"type": "null"}]},
        "semanticRef": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}
      }
    },
    "topologyEdge": {
      "type": "object",
      "required": ["from", "to", "relation"],
      "additionalProperties": false,
      "properties": {
        "from": {"type": "string"},
        "to": {"type": "string"},
        "relation": {"$ref": "#/$defs/edgeKind"}
      }
    },
    "runMap": {
      "type": "object",
      "description": "Exactly one owned child of Run. It has the owning runRef but no independent global Ref or mutable frontier authority.",
      "required": ["runRef", "topologyRevision", "nodes", "edges"],
      "additionalProperties": false,
      "properties": {
        "runRef": {"$ref": "#/$defs/runRef"},
        "topologyRevision": {"$ref": "#/$defs/revision"},
        "nodes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/topologyNode"}},
        "edges": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/topologyEdge"}}
      }
    },
    "runThoughtId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "runThoughtLifecycle": {"enum": ["active", "resolved", "superseded", "integrated", "retained"]},
    "passageAnchor": {
      "type": "object",
      "required": ["startByte", "endByte"],
      "additionalProperties": false,
      "properties": {
        "startByte": {"type": "integer", "minimum": 0},
        "endByte": {"type": "integer", "minimum": 1},
        "label": {"type": "string"}
      }
    },
    "thoughtProducer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agentRef": {"type": "string", "minLength": 1},
        "agencyRef": {"type": "string", "minLength": 1},
        "agentSessionRef": {"type": "string", "minLength": 1},
        "executionRef": {"type": "string", "minLength": 1}
      }
    },
    "runThought": {
      "type": "object",
      "description": "One retained, source-backed cognitive determination inside its owning Run. Relation evidence remains opaque/open so knowledge and QL providers retain their own vocabularies and authority.",
      "required": ["id", "runRef", "anchorRef", "lifecycle"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/runThoughtId"},
        "runRef": {"$ref": "#/$defs/runRef"},
        "anchorRef": {"type": "string", "minLength": 1},
        "anchorRevision": {"type": "string", "minLength": 1},
        "passage": {"$ref": "#/$defs/passageAnchor"},
        "producer": {"$ref": "#/$defs/thoughtProducer"},
        "runMapSubjectRefs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "relatedRefs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "relationEvidenceRefs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "lifecycle": {"$ref": "#/$defs/runThoughtLifecycle"}
      }
    },
    "runThoughtField": {
      "type": "object",
      "description": "Exactly one Run-owned cognitive field with no independent global Ref. Its identity is the owning RunRef; thought ids are local to that Run.",
      "required": ["thoughts"],
      "additionalProperties": false,
      "properties": {
        "thoughts": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/runThoughtId"},
          "additionalProperties": {"$ref": "#/$defs/runThought"}
        }
      }
    },
    "runLifecycle": {
      "enum": ["seeded", "active", "waiting_human", "suspended", "finishing", "finished", "aborted", "archived"]
    },
    "runLifecycleCommand": {
      "type": "object",
      "required": ["commandId", "expectedRevision", "lifecycle"],
      "additionalProperties": false,
      "properties": {
        "commandId": {"type": "string", "minLength": 1},
        "expectedRevision": {"$ref": "#/$defs/revision"},
        "lifecycle": {"$ref": "#/$defs/runLifecycle"}
      }
    },
    "runLifecycleReceipt": {
      "type": "object",
      "required": ["command", "previousLifecycle", "nextRevision", "authorityOwner", "authorityEpoch"],
      "additionalProperties": false,
      "properties": {
        "command": {"$ref": "#/$defs/runLifecycleCommand"},
        "previousLifecycle": {"$ref": "#/$defs/runLifecycle"},
        "nextRevision": {"$ref": "#/$defs/revision"},
        "authorityOwner": {"type": "string", "minLength": 1},
        "authorityEpoch": {"type": "integer", "minimum": 1}
      }
    },
    "run": {
      "type": "object",
      "required": ["ref", "projectRef", "revision", "destination", "lifecycle", "writeAuthority", "map", "appliedCommandIds"],
      "additionalProperties": false,
      "properties": {
        "ref": {"$ref": "#/$defs/runRef"},
        "projectRef": {"$ref": "#/$defs/projectRef"},
        "revision": {"$ref": "#/$defs/revision"},
        "destination": {"type": "string", "minLength": 1},
        "lifecycle": {"$ref": "#/$defs/runLifecycle"},
        "writeAuthority": {
          "type": "object",
          "required": ["owner", "epoch"],
          "additionalProperties": false,
          "properties": {"owner": {"type": "string", "minLength": 1}, "epoch": {"type": "integer", "minimum": 1}}
        },
        "map": {"$ref": "#/$defs/runMap"},
        "thoughtField": {
          "$ref": "#/$defs/runThoughtField",
          "description": "Canonical new writes include this field. It is optional in v1 schema so historical Run records without it remain readable as an empty cognitive field."
        },
        "appliedCommandIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "lifecycleCommands": {
          "type": "object",
          "description": "Exact optional lifecycle command receipts retained by the native Run owner; historical records without the field remain readable.",
          "additionalProperties": {"$ref": "#/$defs/runLifecycleReceipt"}
        }
      }
    }
  }
}
