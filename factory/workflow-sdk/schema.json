{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory.agent-workflow-source.schema/v1",
  "title": "Factory Agent-first workflow source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "coordinationContract",
    "source",
    "workflowKey",
    "units"
  ],
  "properties": {
    "schemaVersion": {
      "const": "factory.agent-workflow-source/v1"
    },
    "coordinationContract": {
      "const": "factory.bounded-coordination/v1"
    },
    "source": {
      "$ref": "#/$defs/sourceProvenance"
    },
    "workflowKey": {
      "$ref": "#/$defs/locator"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/unit"
      }
    },
    "barriers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/barrier"
      }
    },
    "nesting": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nesting"
      }
    }
  },
  "$defs": {
    "locator": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "refSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "locatorSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/locator"
      }
    },
    "textSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmpty"
      }
    },
    "sourceProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "revision",
        "digest"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^workflow-source:[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "revision": {
          "$ref": "#/$defs/nonEmpty"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "temporalRef": {
          "type": "string",
          "minLength": 1
        },
        "flowRef": {
          "type": "string",
          "minLength": 1
        },
        "authoring": {
          "$ref": "#/$defs/authoredBasis"
        }
      }
    },
    "agentRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agentRefs": {
          "$ref": "#/$defs/qualifiedRefSet"
        },
        "agentSetRefs": {
          "$ref": "#/$defs/qualifiedRefSet"
        },
        "agencyRefs": {
          "$ref": "#/$defs/qualifiedRefSet"
        }
      },
      "anyOf": [
        {
          "required": [
            "agentRefs"
          ],
          "properties": {
            "agentRefs": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "agentSetRefs"
          ],
          "properties": {
            "agentSetRefs": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "agencyRefs"
          ],
          "properties": {
            "agencyRefs": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "developmentalConcern",
        "requiredDifference",
        "returnContract",
        "subjectRef",
        "basisRevision",
        "agentRequirements",
        "praxisRefs",
        "capabilityRefs",
        "permittedEffects",
        "verificationObligations",
        "returnAddress",
        "stopConditions",
        "escalationConditions"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/locator"
        },
        "developmentalConcern": {
          "$ref": "#/$defs/nonEmpty"
        },
        "requiredDifference": {
          "$ref": "#/$defs/nonEmpty"
        },
        "returnContract": {
          "$ref": "#/$defs/nonEmpty"
        },
        "subjectRef": {
          "$ref": "#/$defs/qualifiedRef"
        },
        "basisRevision": {
          "$ref": "#/$defs/nonEmpty"
        },
        "agentRequirements": {
          "$ref": "#/$defs/agentRequirements"
        },
        "praxisRefs": {
          "$ref": "#/$defs/qualifiedRefSet"
        },
        "capabilityRefs": {
          "$ref": "#/$defs/qualifiedRefSet"
        },
        "dependencies": {
          "$ref": "#/$defs/locatorSet"
        },
        "independenceFrom": {
          "$ref": "#/$defs/locatorSet"
        },
        "permittedEffects": {
          "allOf": [
            {
              "$ref": "#/$defs/textSet"
            },
            {
              "minItems": 1
            }
          ]
        },
        "verificationObligations": {
          "allOf": [
            {
              "$ref": "#/$defs/textSet"
            },
            {
              "minItems": 1
            }
          ]
        },
        "returnAddress": {
          "$ref": "#/$defs/qualifiedRef"
        },
        "stopConditions": {
          "$ref": "#/$defs/nonEmpty"
        },
        "escalationConditions": {
          "$ref": "#/$defs/nonEmpty"
        },
        "contribution": {
          "$ref": "#/$defs/contribution"
        },
        "inputs": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/workflowInputSource"
          }
        }
      }
    },
    "barrier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "waitsFor",
        "releases"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/locator"
        },
        "waitsFor": {
          "allOf": [
            {
              "$ref": "#/$defs/locatorSet"
            },
            {
              "minItems": 1
            }
          ]
        },
        "releases": {
          "allOf": [
            {
              "$ref": "#/$defs/locatorSet"
            },
            {
              "minItems": 1
            }
          ]
        }
      }
    },
    "nesting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent",
        "child"
      ],
      "properties": {
        "parent": {
          "$ref": "#/$defs/locator"
        },
        "child": {
          "$ref": "#/$defs/locator"
        }
      }
    },
    "sourceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "line",
        "column",
        "byteOffset"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byteOffset": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "moduleBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest",
        "bytes",
        "content"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 524288
        },
        "content": {
          "type": "string",
          "maxLength": 524288
        }
      }
    },
    "sourcePointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "revision",
        "digest"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^workflow-source:[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "authoredBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "compiler",
        "compilerDigest",
        "entry",
        "revision",
        "bundleDigest",
        "modules",
        "locations"
      ],
      "properties": {
        "contract": {
          "const": "factory.authored-workflow-basis/v1"
        },
        "compiler": {
          "type": "string",
          "minLength": 1
        },
        "compilerDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "bundleDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "modules": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/moduleBasis"
          }
        },
        "locations": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sourceLocation"
          }
        },
        "successorOf": {
          "$ref": "#/$defs/sourcePointer"
        }
      }
    },
    "roleSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "ref",
        "revision"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "roleSource"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "roleSource": {
          "$ref": "#/$defs/roleSource"
        },
        "contextRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "requiredTools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "requiredActions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "requiredModalities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "requiredHarnessRef": {
          "type": "string",
          "minLength": 1
        },
        "requiredModelRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "qualifiedRef": {
      "type": "string",
      "minLength": 3,
      "maxLength": 2048,
      "pattern": "^[^\\s\\x00-\\x1f\\x7f]+[:/][^\\s\\x00-\\x1f\\x7f]+$",
      "description": "Owner-qualified native reference; retained verbatim, not a Factory identity, resolution or authority."
    },
    "qualifiedRefSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/qualifiedRef"
      }
    },
    "workflowInputSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predecessor",
        "receivingContextRef"
      ],
      "properties": {
        "predecessor": {
          "type": "string",
          "minLength": 1
        },
        "receivingContextRef": {
          "$ref": "#/$defs/qualifiedRef"
        }
      }
    }
  }
}
