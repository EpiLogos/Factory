{
  "schema": "oi.product-lifecycle/v1",
  "id": "software-factory",
  "public_name": "Software Factory",
  "version": "0.1.0",
  "repository": "https://github.com/EpiLogos/Factory",
  "repository_name_status": "renamed",
  "canonical_repository_name": "Factory",
  "source_checkout": "Factory",
  "artifact": {
    "kind": "cli",
    "entry": "target/release/factory",
    "platforms": ["rust-supported-native-targets"]
  },
  "build": {
    "command": ["cargo", "build", "--workspace", "--locked", "--release"]
  },
  "verify": {
    "source_command": ["cargo", "test", "--workspace", "--locked"],
    "installed_command": ["factory", "verify", "--json"]
  },
  "install": {"mode": "oi-managed-native-cli"},
  "update": {"mode": "suite-manifest"},
  "remove": {"mode": "oi-managed-only"},
  "release": {
    "host": "github-releases",
    "tag_prefix": "software-factory-v",
    "checksum": "sha256",
    "provenance": "github-artifact-attestation"
  }
}
